+#ifdef	_KSL_IBCS_US
+/*
+ * AN exec OF A PROGRAM OF THE INTERFACE STAYS IN THE EMULATION.
+ *
+ * Handed to Linux as it is, exec starts the file as Linux's own program,
+ * outside this emulation, and the program's first call through the gate
+ * faults: a program that starts another of its kind (a shell, a command
+ * interpreter, a test that starts itself) could not.  So a file this emulation
+ * runs is started under it again: this program (/proc/self/exe) with the
+ * options this run was given and the file named by --exec, its arguments
+ * passed on unchanged.  A file it does not run is Linux's, as before: a
+ * script, a program of another architecture, an i386 program that names
+ * Linux's dynamic linker.
+ */
+/*
+ * ibcs_syscall is declared to return a long long, and only its low word is the
+ * system call's: the results are taken as int, as the rest of the program does.
+ */
+static int abi_exec_reads(int fd, u_long at, void* buf, int len)
+{
+	if (IBCS_IS_ERR((int)IBCS_SYSCALL(lseek, fd, at, 0)))
+		return 0;
+	return (int)IBCS_SYSCALL(read, fd, buf, len) == len;
+}
+
+static u_long abi_exec_word(const unsigned char* p, int bytes)
+{
+	u_long	v = 0;
+
+	while (bytes-- > 0)
+		v = (v << 8) | p[bytes];
+	return v;
+}
+
+/*
+ * Whether this emulation runs the file: an i386 COFF (0x14c) or x.out (0x206)
+ * executable, or a 32-bit little-endian i386 ELF whose interpreter, if it names
+ * one, is not Linux's.
+ */
+static int abi_exec_emulated(const char* path)
+{
+	unsigned char	eh[52], ph[32];
+	char		interp[64];
+	int		fd, emulated = 0;
+	u_long		i, phoff, phentsize, phnum;
+
+	fd = (int)IBCS_SYSCALL(open, path, O_RDONLY);
+	if (IBCS_IS_ERR(fd))
+		return 0;
+	if (!abi_exec_reads(fd, 0, eh, 2))
+		goto out;
+	if (abi_exec_word(eh, 2) == 0x14c || abi_exec_word(eh, 2) == 0x206) {
+		emulated = 1;
+		goto out;
+	}
+	if (!abi_exec_reads(fd, 0, eh, sizeof(eh)))
+		goto out;
+	if (eh[0] != 0x7f || eh[1] != 'E' || eh[2] != 'L' || eh[3] != 'F'
+	    || eh[4] != 1 || eh[5] != 1 || abi_exec_word(eh + 18, 2) != 3)
+		goto out;
+	phoff = abi_exec_word(eh + 28, 4);
+	phentsize = abi_exec_word(eh + 42, 2);
+	phnum = abi_exec_word(eh + 44, 2);
+	emulated = 1;
+	for (i = 0; i < phnum && phentsize >= sizeof(ph); i++) {
+		if (!abi_exec_reads(fd, phoff + i * phentsize, ph, sizeof(ph)))
+			break;
+		if (abi_exec_word(ph, 4) == 3) {	/* PT_INTERP */
+			u_long	n = abi_exec_word(ph + 16, 4);
+
+			if (n >= sizeof(interp))
+				n = sizeof(interp) - 1;
+			memset(interp, 0, sizeof(interp));
+			if (abi_exec_reads(fd, abi_exec_word(ph + 4, 4), interp, n)
+			    && strstr(interp, "ld-linux") != (char*)0)
+				emulated = 0;
+			break;
+		}
+	}
+out:
+	IBCS_SYSCALL(close, fd);
+	return emulated;
+}
+
+/*
+ * Start the file under this emulation; returns only on failure.  The file must
+ * be one exec(2) would start: the same check as the kernel's comes first, so
+ * that a file that may not be executed fails here and not in the new run.
+ */
+static int abi_exec_in_emulation(const char* path, const char* const* argv,
+				 const char* const* envp)
+{
+	const char*	head[16];
+	int		nhead, nargs = 0, k = 0, i, error;
+
+	error = (int)IBCS_SYSCALL(access, path, 1);		/* X_OK */
+	if (IBCS_IS_ERR(error))
+		return error;
+	while (argv != (const char* const*)0 && argv[nargs] != (const char*)0)
+		nargs++;
+	nhead = ibcs_exec_options(head, ARRAY_END(head) - head);
+	{
+		const char*	av[nhead + 3 + (nargs ? nargs : 1) + 1];
+
+		for (i = 0; i < nhead; i++)
+			av[k++] = head[i];
+		av[k++] = "-e";
+		av[k++] = path;
+		av[k++] = "--";
+		if (nargs == 0)
+			av[k++] = path;
+		for (i = 0; i < nargs; i++)
+			av[k++] = argv[i];
+		av[k] = (const char*)0;
+		return (int)IBCS_SYSCALL(execve, "/proc/self/exe", av, envp);
+	}
+}
+#endif
