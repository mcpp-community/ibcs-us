 /*
+ * THE OPTIONS A PROGRAM WAS STARTED WITH, KEPT FOR THE PROGRAMS IT STARTS BY
+ * exec.  A program of the interface that replaces its image with another such
+ * program is started again under this emulation (abi_exec), and the new one is
+ * run as this one was: under the personality, the trace flags, the log and the
+ * file map the command line gave.  They are copied here, because the command
+ * line's strings are the emulated program's to overwrite.
+ */
+static char	exec_opt_argv0[256] = "ibcs-us";
+static char	exec_opt_personality[24];
+static char	exec_opt_trace[24];
+static char	exec_opt_log[24];
+static char*	exec_opt_map;
+
+static void keep_exec_options(const struct cmdline_options* o)
+{
+    if (strlen(o->argv0) < sizeof(exec_opt_argv0)) {
+	strcpy(exec_opt_argv0, o->argv0);
+    }
+    if (o->personality != 0) {
+	ibcs_fmt(exec_opt_personality, sizeof(exec_opt_personality), "%lx", o->personality);
+    }
+    if (o->abi_trage_flg != 0) {
+	ibcs_fmt(exec_opt_trace, sizeof(exec_opt_trace), "%x", o->abi_trage_flg);
+    }
+    if (o->abi_trace_fd != 2) {
+	ibcs_fmt(exec_opt_log, sizeof(exec_opt_log), "%d", o->abi_trace_fd);
+    }
+    if (o->filemap_filename != (const char*)0) {
+	exec_opt_map = ibcs_malloc(strlen(o->filemap_filename) + 1);
+	if (exec_opt_map != (char*)0) {
+	    strcpy(exec_opt_map, o->filemap_filename);
+	}
+    }
+}
+
+/*
+ * The head of the command line that starts a program as this one was started:
+ * this program's name, then its options.  `room' must be at least nine.
+ * Returns the number of strings written.
+ */
+int ibcs_exec_options(const char** out, int room)
+{
+    int		n = 0;
+
+    if (room < 9) {
+	return 0;
+    }
+    out[n++] = exec_opt_argv0;
+    if (exec_opt_personality[0] != '\0') {
+	out[n++] = "-p";
+	out[n++] = exec_opt_personality;
+    }
+    if (exec_opt_trace[0] != '\0') {
+	out[n++] = "-t";
+	out[n++] = exec_opt_trace;
+    }
+    if (exec_opt_log[0] != '\0') {
+	out[n++] = "-l";
+	out[n++] = exec_opt_log;
+    }
+    if (exec_opt_map != (char*)0) {
+	out[n++] = "-m";
+	out[n++] = exec_opt_map;
+    }
+    return n;
+}
