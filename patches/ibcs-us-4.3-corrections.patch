+    loff_t	result = 0;
+    int		retval = IBCS_SYSCALL(
+	_llseek, fd, (unsigned long)((u64)to >> 32), (unsigned long)to,
+	&result, whence);
+    if (!IBCS_IS_ERR(retval) && at != (loff_t*)0) {
+	*at = result;
+    }
